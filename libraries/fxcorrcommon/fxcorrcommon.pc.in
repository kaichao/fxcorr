prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: fxcorrcommon
Description: shared non-MPI correlator core split from mpifxcorr (station- and baseline-based processing)
Requires: difxmessage mark5access vdifio codifio
Version: @PACKAGE_VERSION@
Libs: -L${libdir} -lfxcorrcommon @IPP_PC_LIBS@
Cflags: -I${includedir} @IPP_PC_CFLAGS@
